@dc:title "Project Environment Bundle"
@dc:description "A bundle that includes all descriptions in the Project Environment project."
description bundle <https://fireforce6.github.io/project-environment/bundle#> as d-bundle {

	uses <http://purl.org/dc/elements/1.1/> as dc
     uses <https://fireforce6.github.io/sierra/bundle#>

     // All descriptions included in this bundle
     includes <https://fireforce6.github.io/project-environment/description1#>
     includes <https://fireforce6.github.io/project-environment/stakeholders#>
     includes <https://fireforce6.github.io/project-environment/requirements#>
     includes <https://fireforce6.github.io/project-environment/missions#>
     includes <https://fireforce6.github.io/project-environment/capabilities#>
     includes <https://fireforce6.github.io/project-environment/entities#>
     includes <https://fireforce6.github.io/project-environment/processes#>
     includes <https://fireforce6.github.io/project-environment/scenarios#>

}
